# Postgres connection string (Neon → Project → Connection Details).
# For the deployed app (serverless), use the pooled connection string
# (host contains "-pooler", e.g. ep-xxx-pooler.us-east-2.aws.neon.tech).
# For running `pnpm --filter @workspace/db run push` locally, use the
# unpooled/direct connection string instead — PgBouncer transaction mode
# doesn't support the session-level features drizzle-kit needs.
DATABASE_URL=

# Random secret used to sign session cookies. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Base URL of the frontend dev/deployed app — used to build redirect targets
# after Google OAuth and in emailed links. Local dev default: http://localhost:24486
FRONTEND_URL=

# Resend (https://resend.com) API key for sending OTP / verification /
# password-reset emails. Leave unset in dev — codes are logged to the API
# server console instead of being emailed.
RESEND_API_KEY=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
# Leave unset to disable "Continue with Google" (the button is hidden and the
# routes 501 rather than erroring at runtime).
# Redirect URI must be registered on the OAuth client exactly, e.g.
# http://localhost:8080/api/auth/google/callback in dev.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# One-time token used to bootstrap the very first admin account via
# POST /api/admin/setup. Generate with: openssl rand -base64 32
ADMIN_SETUP_TOKEN=
